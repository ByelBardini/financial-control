PORT=8080
DATABASE_URL=postgres://financial:financial@localhost:5432/financial_control?sslmode=disable
# Obrigatório: segredo de assinatura do JWT (>= 32 bytes). Gere um valor aleatório forte.
JWT_SECRET=
# Opcionais (defaults): validade do token sem / com "lembre de mim".
JWT_TTL_DEFAULT=24h
JWT_TTL_REMEMBER=720h
# Origem permitida no CORS (default "*"). Trave numa origem específica em produção.
CORS_ALLOW_ORIGIN=*
