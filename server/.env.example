PORT=8080
DATABASE_URL=postgres://financial:financial@localhost:5432/financial_control?sslmode=disable
# Obrigatório: segredo de assinatura do JWT (>= 32 bytes). Gere um valor aleatório forte.
JWT_SECRET=
# Opcionais (defaults): validade do token sem / com "lembre de mim".
JWT_TTL_DEFAULT=24h
JWT_TTL_REMEMBER=720h
# Origem permitida no CORS (default "*"). Trave numa origem específica em produção.
CORS_ALLOW_ORIGIN=*
# Cotação automática de preço (opcionais, fail-soft — ausentes não impedem o server subir).
# brapi (ações/FIIs): sem token só os tickers de teste funcionam. Gere em https://brapi.dev/dashboard
BRAPI_TOKEN=
# CoinGecko (cripto): funciona keyless; chave Demo sobe o limite. https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Job diário de cotação (EOD). Opt-in: liga só quando quiser atualizar o fechamento automaticamente.
QUOTE_JOB_ENABLED=false
# Horário do job, em Brasília (HH:MM). Default 18:30 (após o fechamento da B3).
QUOTE_JOB_AT=18:30
